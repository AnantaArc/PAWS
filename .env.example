# ============================================================
# PAWS CONSOLE — ENVIRONMENT
# Copy to .env. Everything is optional: with nothing set the
# console boots in LOCAL DEMO MODE (simulator + demo accounts).
# ============================================================

# local  -> in-memory store + robot simulator (no cloud needed)
# supabase -> real Postgres + RLS + persistent missions
DATA_MODE=local

# Secret for local session + field-link signing (openssl rand -hex 32)
AUTH_SECRET=paws-dev-secret-change-me

# Token the ESP32 must present at /api/ingest
INGEST_DEVICE_TOKEN=paws-device-token

# --- Supabase (only when DATA_MODE=supabase) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Detection ---------------------------------------------------------------
# simulated -> scripted detections (SIMULATED badge)
# server    -> POST frame to DETECTION_SERVICE_URL, expect {detections:[...]}
DETECTION_PROVIDER=simulated
DETECTION_SERVICE_URL=

# --- Simulator tick (ms, default 1000) --------------------------------------
SIM_TICK_MS=1000
